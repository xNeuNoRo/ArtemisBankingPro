@model CashierOperationListViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["PaginationDateFrom"] = Model.DateFrom;
    ViewData["PaginationDateTo"] = Model.DateTo;
    ViewData["PaginationOperationType"] = Model.OperationType;
    string Money(decimal amount) => $"RD$ {amount.ToString("N2", CultureInfo.InvariantCulture)}";
    string OperationLabel(string kind) => kind switch {
        "Deposit" => "Depósito",
        "Withdrawal" => "Retiro",
        "CreditCardPayment" => "Pago a tarjeta de crédito",
        "LoanPayment" => "Pago a préstamo",
        "CashierTransfer" or "ThirdPartyTransfer" => "Transacción a cuenta de terceros",
        _ => "Operación financiera",
    };
    string? RejectionMessage(string? code) => code switch {
        "Account.InsufficientFunds" => "El monto ingresado excede el saldo disponible de la cuenta.",
        "Account.NotActive" => "La cuenta de ahorro no está activa.",
        "Account.SourceNotFound" or "Account.DestinationNotFound" => "La cuenta indicada no corresponde a una cuenta válida.",
        "Card.NotFound" or "Card.NotActive" => "La tarjeta seleccionada no corresponde a una tarjeta válida.",
        "Card.Expired" => "La tarjeta de crédito está vencida.",
        "Card.NoDebt" => "La tarjeta seleccionada no tiene deuda pendiente.",
        "Card.InsufficientCredit" => "La tarjeta de crédito no tiene crédito disponible suficiente.",
        "Loan.NotFound" or "Loan.NotActive" => "El número de préstamo ingresado no corresponde a un préstamo válido.",
        "Loan.NoPendingInstallments" => "El préstamo seleccionado no tiene cuotas pendientes de pago.",
        "Operation.SameAccount" => "La cuenta origen y la cuenta destino no pueden ser la misma.",
        "Operation.DestinationMustBeThirdParty" => "La cuenta destino debe pertenecer a un tercero.",
        null or "" => null,
        _ => "La operación fue rechazada y no modificó los fondos.",
    };
    string ProductDisplay(CashierOperationItemViewModel operation) {
        if (!string.IsNullOrWhiteSpace(operation.CardLastFour)) {
            return $"Tarjeta terminada en {operation.CardLastFour}";
        }

        return string.IsNullOrWhiteSpace(operation.LoanNumber)
            ? "No aplica"
            : $"Préstamo {operation.LoanNumber}";
    }
}

<section class="page-header" aria-labelledby="cashier-operations-title">
    <div class="page-header__content">
        <p class="page-header__eyebrow">Cajero / Actividad</p>
        <h1 id="cashier-operations-title" class="page-header__title">Historial de operaciones</h1>
        <p class="page-header__description">Consulte las operaciones registradas por su usuario de cajero con filtros y paginación.</p>
    </div>
    <div class="page-header__actions">
        <a class="ui-button ui-button--primary" asp-controller="Cashier" asp-action="Deposit">Nueva operación</a>
    </div>
</section>

<section class="ui-card client-filter" aria-labelledby="cashier-operations-filter-title">
    <div class="ui-card__header"><div><h2 id="cashier-operations-filter-title" class="ui-card__title">Filtrar operaciones</h2><p class="ui-card__description">El historial muestra únicamente las operaciones de este cajero. Las fechas seleccionadas incluyen el día completo.</p></div></div>
    <div class="ui-card__body">
        <partial name="_ValidationSummary" />
        <form asp-controller="Cashier" asp-action="Operations" method="get" class="client-filter__form">
            <div class="ui-field"><label class="ui-label" for="DateFrom">Fecha desde</label><input class="ui-control" id="DateFrom" name="dateFrom" type="date" value="@(Model.DateFrom?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" aria-describedby="DateFrom-help DateFrom-error" /><p id="DateFrom-help" class="ui-field-description">Desde el inicio de la fecha seleccionada.</p><span class="ui-error" asp-validation-for="DateFrom"></span></div>
            <div class="ui-field"><label class="ui-label" for="DateTo">Fecha hasta</label><input class="ui-control" id="DateTo" name="dateTo" type="date" value="@(Model.DateTo?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" aria-describedby="DateTo-help DateTo-error" /><p id="DateTo-help" class="ui-field-description">Hasta el final de la fecha seleccionada.</p><span class="ui-error" asp-validation-for="DateTo"></span></div>
            <div class="ui-field"><label class="ui-label" for="OperationType">Tipo de operación</label><select class="ui-control" id="OperationType" name="operationType" aria-describedby="OperationType-error">
                @foreach (SelectOptionViewModel option in Model.OperationTypeOptions) { <option value="@option.Value" selected="@(option.IsSelected ? "selected" : null)">@option.Text</option> }
            </select><span class="ui-error" asp-validation-for="OperationType"></span></div>
            <button class="ui-button ui-button--primary" type="submit">Aplicar filtros</button>
        </form>
    </div>
</section>

@if (ViewData.ModelState.IsValid && Model.Operations.Count == 0) {
    ViewData["EmptyTitle"] = "No hay operaciones para estos filtros.";
    ViewData["EmptyDescription"] = "Pruebe con otro rango de fechas o tipo de operación.";
    <partial name="_EmptyState" />
    <div class="page-actions">
        <a class="ui-button ui-button--secondary" asp-controller="Cashier" asp-action="Operations">Limpiar filtros</a>
    </div>
} else if (ViewData.ModelState.IsValid) {
    <section class="client-list" aria-labelledby="cashier-operations-list-title">
        <div class="client-list__heading"><div><p class="ui-section-label">Actividad registrada</p><h2 id="cashier-operations-list-title" class="ui-card__title">Operaciones recientes</h2></div><span class="ui-badge ui-badge--info">@Model.Pagination.TotalItems registros</span></div>
        <div class="ui-table-wrap" tabindex="0" role="region" aria-label="Tabla de operaciones de caja">
            <table class="ui-table client-table">
                <caption class="ui-visually-hidden">Operaciones del cajero autenticado, ordenadas de la más reciente a la más antigua</caption>
                <thead><tr><th scope="col" aria-sort="descending">Fecha y hora</th><th scope="col">Tipo</th><th scope="col">Monto</th><th scope="col">Cuenta</th><th scope="col">Producto</th><th scope="col">Estado</th></tr></thead>
                <tbody>
                    @foreach (CashierOperationItemViewModel operation in Model.Operations) {
                        <tr>
                            <td>@BusinessClock.ToBusinessTime(operation.OccurredAt).ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                            <td class="ui-table__primary">@OperationLabel(operation.Kind)</td>
                            <td class="ui-table__numeric">@Money(operation.Amount)</td>
                            <td>@(string.IsNullOrWhiteSpace(operation.AccountLastFour) ? "No aplica" : $"Cuenta terminada en {operation.AccountLastFour}")</td>
                            <td>@ProductDisplay(operation)</td>
                            <td><partial name="_StatusBadge" model="operation.Status" />@if (RejectionMessage(operation.RejectionCode) is { } rejectionMessage) { <small class="ui-field-description">Motivo: @rejectionMessage</small> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model.Pagination" />
    </section>
}
