@model CashierOperationConfirmationViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    string Money(decimal? amount) => amount is null
        ? "No indicado"
        : $"RD$ {amount.Value.ToString("N2", CultureInfo.InvariantCulture)}";
}

<section class="page-header" aria-labelledby="cashier-confirmation-title">
    <div class="page-header__content">
        <p class="page-header__eyebrow">Cajero / Confirmación</p>
        <h1 id="cashier-confirmation-title" class="page-header__title">Confirmar @Model.OperationLabel.ToLowerInvariant()</h1>
        <p class="page-header__description">Revise los datos antes de confirmar. El servidor volverá a validar el estado financiero y la huella de la solicitud.</p>
    </div>
</section>

<section class="ui-card ui-confirmation-panel client-confirmation" aria-labelledby="cashier-confirmation-message">
    <div class="ui-card__body">
        <p id="cashier-confirmation-message" class="ui-confirmation-panel__title">@Model.ConfirmationMessage</p>
        <dl class="client-confirmation__summary">
            @if (!string.IsNullOrWhiteSpace(Model.SourceOwnerName)) { <div><dt>Titular origen</dt><dd>@Model.SourceOwnerName</dd></div> }
            @if (!string.IsNullOrWhiteSpace(Model.DestinationOwnerName)) { <div><dt>Titular destino</dt><dd>@Model.DestinationOwnerName</dd></div> }
            @if (!string.IsNullOrWhiteSpace(Model.AccountNumber)) { <div><dt>Cuenta</dt><dd>@Model.AccountNumber</dd></div> }
            @if (!string.IsNullOrWhiteSpace(Model.SourceAccountNumber)) { <div><dt>Cuenta origen</dt><dd>@Model.SourceAccountNumber</dd></div> }
            @if (!string.IsNullOrWhiteSpace(Model.DestinationAccountNumber)) { <div><dt>Cuenta destino</dt><dd>@Model.DestinationAccountNumber</dd></div> }
            @if (!string.IsNullOrWhiteSpace(Model.CardLastFour)) { <div><dt>Tarjeta</dt><dd>•••• @Model.CardLastFour</dd></div> }
            @if (!string.IsNullOrWhiteSpace(Model.LoanNumber)) { <div><dt>Préstamo</dt><dd>@Model.LoanNumber</dd></div> }
            @if (Model.RequestedAmount is not null) { <div><dt>Monto solicitado</dt><dd>@Money(Model.RequestedAmount)</dd></div> }
            @if (Model.EffectiveAmount is not null && Model.EffectiveAmount != Model.RequestedAmount) { <div><dt>Monto aplicado</dt><dd>@Money(Model.EffectiveAmount)</dd></div> }
        </dl>
        <partial name="_ValidationSummary" />
        <form asp-controller="Cashier" asp-action="@Model.ConfirmAction" method="post" data-submit-lock data-autofocus-error class="page-actions">
            <input asp-for="ConfirmationToken" type="hidden" />
            @if (Model.AccountNumber is not null) { <input asp-for="AccountNumber" type="hidden" /> }
            @if (Model.SourceAccountNumber is not null) { <input asp-for="SourceAccountNumber" type="hidden" /> }
            @if (Model.DestinationAccountNumber is not null) { <input asp-for="DestinationAccountNumber" type="hidden" /> }
            @if (Model.CardId is not null) { <input asp-for="CardId" type="hidden" /> }
            @if (Model.LoanId is not null) { <input asp-for="LoanId" type="hidden" /> }
            @if (Model.RequestedAmount is not null) { <input asp-for="RequestedAmount" type="hidden" /> }
            <a class="ui-button ui-button--secondary" asp-controller="Home" asp-action="Cashier">Cancelar</a>
            <button class="ui-button ui-button--primary" type="submit"><span data-submit-label>Confirmar operación</span></button>
        </form>
    </div>
</section>
