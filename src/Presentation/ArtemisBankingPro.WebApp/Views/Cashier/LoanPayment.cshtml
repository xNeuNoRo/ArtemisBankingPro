@model CashierOperationPageViewModel<LoanPaymentViewModel>
@{
    ViewData["Title"] = Model.PageTitle;
    bool canSubmit = !Model.HasLoadError && Model.Form.LoanOptions.Count > 0;
}

<section class="page-header" aria-labelledby="cashier-loan-payment-title">
    <div class="page-header__content">
        <p class="page-header__eyebrow">Cajero / Obligaciones</p>
        <h1 id="cashier-loan-payment-title" class="page-header__title">Pago a préstamo</h1>
        <p class="page-header__description">Aplique fondos de una cuenta activa a las cuotas pendientes del préstamo seleccionado.</p>
    </div>
</section>

@if (Model.HasLoadError) {
    <section class="ui-alert ui-alert--danger" role="alert" aria-live="assertive"><p class="ui-alert__content">@Model.LoadErrorMessage</p></section>
}
@if (!canSubmit) {
    ViewData["EmptyTitle"] = "No hay préstamos activos disponibles.";
    ViewData["EmptyDescription"] = "El pago estará disponible cuando exista un préstamo activo con cuotas pendientes.";
    <partial name="_EmptyState" />
} else {
    <section class="ui-card client-form-panel" aria-labelledby="cashier-loan-payment-form-title">
        <div class="ui-card__header"><div><p class="ui-section-label">Nueva operación</p><h2 id="cashier-loan-payment-form-title" class="ui-card__title">Datos del pago</h2></div></div>
        <div class="ui-card__body">
            <partial name="_ValidationSummary" />
            <form asp-controller="Cashier" asp-action="LoanPayment" method="post" data-submit-lock data-autofocus-error class="client-form">
                <div class="ui-field">
                    <label class="ui-label" asp-for="Form.LoanId">Préstamo</label>
                    <select class="ui-control" asp-for="Form.LoanId" required>
                        <option value="0" disabled>Seleccione un préstamo</option>
                        @foreach (SelectOptionViewModel option in Model.Form.LoanOptions) { <option value="@option.Value">@option.Text</option> }
                    </select>
                    <span class="ui-error" asp-validation-for="Form.LoanId"></span>
                </div>
                <div class="ui-field">
                    <label class="ui-label" asp-for="Form.AccountNumber">Cuenta origen</label>
                    <input class="ui-control" asp-for="Form.AccountNumber" inputmode="numeric" maxlength="9" pattern="[0-9]{9}" autocomplete="off" required />
                    <span class="ui-error" asp-validation-for="Form.AccountNumber"></span>
                </div>
                <div class="ui-field">
                    <label class="ui-label" asp-for="Form.Amount">Monto a pagar</label>
                    <input class="ui-control" asp-for="Form.Amount" type="number" min="0.01" step="0.01" inputmode="decimal" autocomplete="off" required />
                    <p class="ui-field-description">Si el monto supera la deuda pendiente, se aplicará el saldo real.</p>
                    <span class="ui-error" asp-validation-for="Form.Amount"></span>
                </div>
                <div class="page-actions">
                    <a class="ui-button ui-button--secondary" asp-controller="Home" asp-action="Cashier">Cancelar</a>
                    <button class="ui-button ui-button--primary" type="submit"><span data-submit-label>Continuar</span></button>
                </div>
            </form>
        </div>
    </section>
}
