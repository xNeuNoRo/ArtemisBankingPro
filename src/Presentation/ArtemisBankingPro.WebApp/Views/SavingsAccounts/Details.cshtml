@model AccountDetailViewModel
@{
    ViewData["Title"] = "Detalle de cuenta";
    ViewData["PaginationAccountNumber"] = Model.AccountNumber;
    string Money(decimal amount) => $"RD$ {amount.ToString("N2", CultureInfo.InvariantCulture)}";
}

<section class="page-header" aria-labelledby="account-details-title"><div class="page-header__content"><p class="page-header__eyebrow">Administración / Cuentas</p><h1 id="account-details-title" class="page-header__title">Detalle de cuenta de ahorro</h1><p class="page-header__description">Consulte el balance y el historial financiero de la cuenta seleccionada.</p></div><div class="page-header__actions"><a class="ui-button ui-button--secondary" asp-action="Index">Volver al listado</a>@if ((Model.Type.Equals("Secondary", StringComparison.OrdinalIgnoreCase) || Model.Type.Equals("Secundaria", StringComparison.OrdinalIgnoreCase)) && (Model.Status.Equals("Active", StringComparison.OrdinalIgnoreCase) || Model.Status.Equals("Activa", StringComparison.OrdinalIgnoreCase))) {<a class="ui-button ui-button--danger" asp-action="ConfirmCancel" asp-route-accountNumber="@Model.AccountNumber">Cancelar cuenta</a>}</div></section>
<section class="ui-card" aria-labelledby="account-summary-title"><div class="ui-card__header"><div><p class="ui-section-label">Cuenta seleccionada</p><h2 id="account-summary-title" class="ui-card__title">@Model.AccountNumber</h2><p class="ui-card__description">@Model.ClientFullName</p></div><div class="admin-product__actions"><span class="ui-badge ui-badge--info">@Model.Type</span><partial name="_StatusBadge" model="Model.Status" /></div></div><div class="ui-card__body admin-product__metric-grid"><div class="admin-product__metric"><span class="admin-product__metric-label">Balance disponible</span><strong class="admin-product__metric-value">@Money(Model.Balance)</strong></div><div class="admin-product__metric"><span class="admin-product__metric-label">Movimientos</span><strong class="admin-product__metric-value">@Model.Pagination.TotalItems</strong></div></div></section>
<section class="admin-product__list" aria-labelledby="account-transactions-title"><div class="admin-users__list-heading"><div><p class="ui-section-label">Historial</p><h2 id="account-transactions-title" class="ui-card__title">Transacciones</h2></div><span class="ui-badge ui-badge--neutral">@Model.Pagination.TotalItems registros</span></div>@if (Model.Transactions.Count == 0) { ViewData["EmptyTitle"] = "No hay transacciones registradas"; ViewData["EmptyDescription"] = "La cuenta todavía no tiene movimientos para mostrar."; <partial name="_EmptyState" /> } else { <div class="ui-table-wrap" tabindex="0" role="region" aria-label="Tabla de transacciones de la cuenta"><table class="ui-table admin-product__table"><caption class="ui-visually-hidden">Transacciones de la cuenta @Model.AccountNumber</caption><thead><tr><th scope="col">Fecha</th><th scope="col">Tipo</th><th scope="col">Origen</th><th scope="col">Beneficiario</th><th scope="col">Monto</th><th scope="col">Estado</th></tr></thead><tbody>@foreach (AccountTransactionItemViewModel transaction in Model.Transactions) {<tr><td>@BusinessClock.ToBusinessTime(transaction.Date).ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)</td><td class="ui-table__primary">@transaction.TransactionType</td><td>@transaction.Origin</td><td>@transaction.Beneficiary</td><td class="ui-table__numeric">@Money(transaction.Amount)</td><td><partial name="_StatusBadge" model="transaction.Status" /></td></tr>}</tbody></table></div><partial name="_Pagination" model="Model.Pagination" /> }</section>
