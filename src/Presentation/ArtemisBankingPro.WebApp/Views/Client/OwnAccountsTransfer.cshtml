@model ClientOperationPageViewModel<OwnAccountsTransferViewModel>
@{
    ViewData["Title"] = Model.PageTitle;
    bool canSubmit = Model.Form.AccountOptions.Count > 1;
    bool sourceInvalid = ViewData.ModelState["Form.SourceAccountNumber"]?.Errors.Count > 0;
    bool destinationInvalid = ViewData.ModelState["Form.DestinationAccountNumber"]?.Errors.Count > 0;
    bool amountInvalid = ViewData.ModelState["Form.Amount"]?.Errors.Count > 0;
}

<section class="page-header" aria-labelledby="own-transfer-title">
    <div class="page-header__content"><p class="page-header__eyebrow">Cliente / Transacciones</p><h1 id="own-transfer-title" class="page-header__title">Transferencia entre cuentas propias</h1><p class="page-header__description">Mueva fondos entre dos cuentas de ahorro activas de su propiedad. La transferencia se ejecutará solo después de su confirmación.</p></div>
    <div class="page-header__actions"><a class="ui-button ui-button--secondary" asp-controller="Home" asp-action="Client">Volver al Home</a></div>
</section>

<partial name="_ValidationSummary" />

@if (!canSubmit) {
    ViewData["EmptyTitle"] = "Necesita al menos dos cuentas activas.";
    ViewData["EmptyDescription"] = "La transferencia entre cuentas propias requiere dos cuentas de ahorro activas del mismo cliente.";
    <partial name="_EmptyState" />
} else {
    <section class="ui-card client-form-panel" aria-labelledby="own-transfer-form-title">
        <div class="ui-card__header"><div><p class="ui-section-label">Nueva operación</p><h2 id="own-transfer-form-title" class="ui-card__title">Datos de la transferencia</h2></div></div>
        <div class="ui-card__body">
            <form asp-controller="Client" asp-action="OwnAccountsTransfer" method="post" data-submit-lock data-autofocus-error class="client-form" aria-labelledby="own-transfer-form-title">
                <input asp-for="Form.SubmissionToken" type="hidden" />
                <div class="client-form__grid">
                    <div class="ui-field"><label class="ui-label" asp-for="Form.SourceAccountNumber">Cuenta de origen</label><select class="ui-control" asp-for="Form.SourceAccountNumber" aria-invalid="@(sourceInvalid ? "true" : "false")" aria-describedby="Form_SourceAccountNumber-help Form_SourceAccountNumber-error" required><option value="" disabled selected="@(string.IsNullOrWhiteSpace(Model.Form.SourceAccountNumber) ? "selected" : null)">Seleccione una cuenta</option>@foreach (SelectOptionViewModel option in Model.Form.AccountOptions) { <option value="@option.Value">@option.Text</option> }</select><p id="Form_SourceAccountNumber-help" class="ui-field-description">Seleccione la cuenta activa desde la que saldrán los fondos.</p><span id="Form_SourceAccountNumber-error" class="ui-error" asp-validation-for="Form.SourceAccountNumber"></span></div>
                    <div class="ui-field"><label class="ui-label" asp-for="Form.DestinationAccountNumber">Cuenta de destino</label><select class="ui-control" asp-for="Form.DestinationAccountNumber" aria-invalid="@(destinationInvalid ? "true" : "false")" aria-describedby="Form_DestinationAccountNumber-help Form_DestinationAccountNumber-error" required><option value="" disabled selected="@(string.IsNullOrWhiteSpace(Model.Form.DestinationAccountNumber) ? "selected" : null)">Seleccione una cuenta</option>@foreach (SelectOptionViewModel option in Model.Form.AccountOptions) { <option value="@option.Value">@option.Text</option> }</select><p id="Form_DestinationAccountNumber-help" class="ui-field-description">Seleccione otra cuenta activa propia; no puede ser la misma de origen.</p><span id="Form_DestinationAccountNumber-error" class="ui-error" asp-validation-for="Form.DestinationAccountNumber"></span></div>
                </div>
                <div class="ui-field"><label class="ui-label" asp-for="Form.Amount">Monto a transferir</label><input class="ui-control" asp-for="Form.Amount" type="number" min="0.01" step="0.01" inputmode="decimal" autocomplete="off" aria-invalid="@(amountInvalid ? "true" : "false")" aria-describedby="Form_Amount-help Form_Amount-error" required /><p id="Form_Amount-help" class="ui-field-description">Debe ser mayor que RD$ 0.00 y no superar el saldo disponible de la cuenta de origen.</p><span id="Form_Amount-error" class="ui-error" asp-validation-for="Form.Amount"></span></div>
                <div class="page-actions"><a class="ui-button ui-button--secondary" asp-controller="Home" asp-action="Client" aria-label="Cancelar y volver al Home">Cancelar</a><button class="ui-button ui-button--primary" type="submit" data-submitting-label="Validando transferencia…"><span data-submit-label>Realizar transferencia</span></button></div>
            </form>
        </div>
    </section>
}
