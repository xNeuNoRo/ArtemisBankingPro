@model RemoveBeneficiaryViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

<section class="page-header" aria-labelledby="remove-beneficiary-title">
    <div class="page-header__content">
        <p class="page-header__eyebrow">Cliente / Beneficiarios</p>
        <h1 id="remove-beneficiary-title" class="page-header__title">@Model.Title</h1>
        <p class="page-header__description">Solo se eliminará la relación guardada; la cuenta de ahorro y su historial no serán eliminados.</p>
    </div>
    <div class="page-header__actions">
        <a class="ui-button ui-button--secondary" asp-controller="Home" asp-action="Client">Volver al Home</a>
    </div>
</section>

<section class="ui-card ui-confirmation-panel client-confirmation" aria-labelledby="remove-beneficiary-message" aria-describedby="remove-beneficiary-safety">
    <div class="ui-card__body">
        <p id="remove-beneficiary-message" class="ui-confirmation-panel__title">@Model.Message</p>
        <p id="remove-beneficiary-safety" class="ui-card__description">La eliminación no modifica transferencias anteriores ni la cuenta del beneficiario.</p>
        <dl class="client-confirmation__summary">
            <div><dt>Beneficiario</dt><dd>@Model.BeneficiaryName</dd></div>
            <div><dt>Cuenta</dt><dd>@Model.AccountNumber</dd></div>
        </dl>
        <partial name="_ValidationSummary" />
        <form asp-controller="Client" asp-action="RemoveBeneficiary" asp-route-id="@Model.BeneficiaryId" method="post" data-submit-lock data-autofocus-error class="page-actions">
            <input asp-for="ConfirmationToken" type="hidden" />
            <a class="ui-button ui-button--secondary" asp-controller="Client" asp-action="Beneficiaries">@Model.CancelButtonText</a>
            <button class="ui-button ui-button--danger" type="submit" data-submitting-label="Eliminando beneficiario…">
                <span data-submit-label>@Model.ConfirmButtonText</span>
            </button>
        </form>
    </div>
</section>
