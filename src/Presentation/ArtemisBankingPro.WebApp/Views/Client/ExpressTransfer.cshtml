@model ClientOperationPageViewModel<ExpressTransactionViewModel>
@{
    ViewData["Title"] = Model.PageTitle;
    bool canSubmit = Model.Form.SourceAccountOptions.Count > 0;
    bool sourceInvalid = ViewData.ModelState["Form.SourceAccountNumber"]?.Errors.Count > 0;
    bool destinationInvalid = ViewData.ModelState["Form.DestinationAccountNumber"]?.Errors.Count > 0;
    bool amountInvalid = ViewData.ModelState["Form.Amount"]?.Errors.Count > 0;
}

<section class="page-header" aria-labelledby="express-transfer-title">
    <div class="page-header__content">
        <p class="page-header__eyebrow">Cliente / Transacciones</p>
        <h1 id="express-transfer-title" class="page-header__title">Transferencia express</h1>
        <p class="page-header__description">Envíe fondos desde una cuenta propia activa hacia otra cuenta de ahorro activa. El servidor validará el destinatario antes de mostrar la confirmación.</p>
    </div>
    <div class="page-header__actions">
        <a class="ui-button ui-button--secondary" asp-controller="Home" asp-action="Client">Volver al Home</a>
    </div>
</section>

<partial name="_ValidationSummary" />

@if (!canSubmit) {
    ViewData["EmptyTitle"] = "No tiene cuentas activas para transferir.";
    ViewData["EmptyDescription"] = "La transferencia express estará disponible cuando tenga una cuenta de ahorro activa.";
    <partial name="_EmptyState" />
} else {
    <section class="ui-card client-form-panel" aria-labelledby="express-form-title">
        <div class="ui-card__header"><div><p class="ui-section-label">Nueva operación</p><h2 id="express-form-title" class="ui-card__title">Datos de la transferencia</h2></div></div>
        <div class="ui-card__body">
            <form asp-controller="Client" asp-action="ExpressTransfer" method="post" data-submit-lock data-autofocus-error class="client-form" aria-labelledby="express-form-title">
                <input asp-for="Form.SubmissionToken" type="hidden" />
                <div class="client-form__grid">
                    <div class="ui-field">
                        <label class="ui-label" asp-for="Form.SourceAccountNumber">Cuenta de origen</label>
                        <select class="ui-control" asp-for="Form.SourceAccountNumber" aria-invalid="@(sourceInvalid ? "true" : "false")" aria-describedby="Form_SourceAccountNumber-help Form_SourceAccountNumber-error" required>
                            <option value="" disabled selected="@(string.IsNullOrWhiteSpace(Model.Form.SourceAccountNumber) ? "selected" : null)">Seleccione una cuenta</option>
                            @foreach (SelectOptionViewModel option in Model.Form.SourceAccountOptions) { <option value="@option.Value">@option.Text</option> }
                        </select>
                        <p id="Form_SourceAccountNumber-help" class="ui-field-description">Solo puede usar una cuenta de ahorro activa que le pertenezca.</p>
                        <span id="Form_SourceAccountNumber-error" class="ui-error" asp-validation-for="Form.SourceAccountNumber"></span>
                    </div>
                    <div class="ui-field">
                        <label class="ui-label" asp-for="Form.DestinationAccountNumber">Cuenta de destino</label>
                        <input class="ui-control" asp-for="Form.DestinationAccountNumber" inputmode="numeric" autocomplete="off" maxlength="9" pattern="[0-9]{9}" aria-invalid="@(destinationInvalid ? "true" : "false")" aria-describedby="Form_DestinationAccountNumber-help Form_DestinationAccountNumber-error" required />
                        <p id="Form_DestinationAccountNumber-help" class="ui-field-description">Escriba los nueve dígitos de la cuenta activa que recibirá los fondos.</p>
                        <span id="Form_DestinationAccountNumber-error" class="ui-error" asp-validation-for="Form.DestinationAccountNumber"></span>
                    </div>
                </div>
                <div class="ui-field">
                    <label class="ui-label" asp-for="Form.Amount">Monto a transferir</label>
                    <input class="ui-control" asp-for="Form.Amount" type="number" min="0.01" step="0.01" inputmode="decimal" autocomplete="off" aria-invalid="@(amountInvalid ? "true" : "false")" aria-describedby="Form_Amount-help Form_Amount-error" required />
                    <p id="Form_Amount-help" class="ui-field-description">Debe ser mayor que RD$ 0.00 y no superar el saldo disponible al confirmar.</p>
                    <span id="Form_Amount-error" class="ui-error" asp-validation-for="Form.Amount"></span>
                </div>
                <div class="page-actions"><a class="ui-button ui-button--secondary" asp-controller="Home" asp-action="Client" aria-label="Cancelar y volver al Home">Cancelar</a><button class="ui-button ui-button--primary" type="submit" data-submitting-label="Validando transacción…"><span data-submit-label>Realizar transacción</span></button></div>
            </form>
        </div>
    </section>
}
