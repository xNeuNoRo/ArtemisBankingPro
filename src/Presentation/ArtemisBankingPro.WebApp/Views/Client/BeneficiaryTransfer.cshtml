@model ClientOperationPageViewModel<BeneficiaryTransferViewModel>
@{
    ViewData["Title"] = Model.PageTitle;
    bool canSubmit = Model.Form.SourceAccountOptions.Count > 0 && Model.Form.BeneficiaryOptions.Count > 0;
    bool beneficiaryInvalid = ViewData.ModelState["Form.BeneficiaryId"]?.Errors.Count > 0;
    bool sourceInvalid = ViewData.ModelState["Form.SourceAccountNumber"]?.Errors.Count > 0;
    bool amountInvalid = ViewData.ModelState["Form.Amount"]?.Errors.Count > 0;
}

<section class="page-header" aria-labelledby="beneficiary-transfer-title">
    <div class="page-header__content"><p class="page-header__eyebrow">Cliente / Transacciones</p><h1 id="beneficiary-transfer-title" class="page-header__title">Transferencia a beneficiario</h1><p class="page-header__description">Transfiera fondos a una cuenta activa que ya haya registrado. El servidor verificará la relación antes de confirmar.</p></div>
    <div class="page-header__actions"><a class="ui-button ui-button--secondary" asp-controller="Home" asp-action="Client">Volver al Home</a></div>
</section>

<partial name="_ValidationSummary" />

@if (!canSubmit) {
    ViewData["EmptyTitle"] = Model.Form.BeneficiaryOptions.Count == 0 ? "No tiene beneficiarios registrados." : "No tiene cuentas activas para transferir.";
    ViewData["EmptyDescription"] = "Registre un beneficiario y mantenga una cuenta de ahorro activa para operar.";
    <partial name="_EmptyState" />
} else {
    <section class="ui-card client-form-panel" aria-labelledby="beneficiary-transfer-form-title">
        <div class="ui-card__header"><div><p class="ui-section-label">Nueva operación</p><h2 id="beneficiary-transfer-form-title" class="ui-card__title">Datos de la transferencia</h2></div></div>
        <div class="ui-card__body">
            <form asp-controller="Client" asp-action="BeneficiaryTransfer" method="post" data-submit-lock data-autofocus-error class="client-form" aria-labelledby="beneficiary-transfer-form-title">
                <input asp-for="Form.SubmissionToken" type="hidden" />
                <div class="client-form__grid">
                    <div class="ui-field"><label class="ui-label" asp-for="Form.BeneficiaryId">Beneficiario</label><select class="ui-control" asp-for="Form.BeneficiaryId" aria-invalid="@(beneficiaryInvalid ? "true" : "false")" aria-describedby="Form_BeneficiaryId-help Form_BeneficiaryId-error" required><option value="0" disabled selected="@(Model.Form.BeneficiaryId <= 0 ? "selected" : null)">Seleccione un beneficiario</option>@foreach (SelectOptionViewModel option in Model.Form.BeneficiaryOptions) { <option value="@option.Value">@option.Text</option> }</select><p id="Form_BeneficiaryId-help" class="ui-field-description">Se muestran el nombre y la cuenta de cada beneficiario registrado.</p><span id="Form_BeneficiaryId-error" class="ui-error" asp-validation-for="Form.BeneficiaryId"></span></div>
                    <div class="ui-field"><label class="ui-label" asp-for="Form.SourceAccountNumber">Cuenta de origen</label><select class="ui-control" asp-for="Form.SourceAccountNumber" aria-invalid="@(sourceInvalid ? "true" : "false")" aria-describedby="Form_SourceAccountNumber-help Form_SourceAccountNumber-error" required><option value="" disabled selected="@(string.IsNullOrWhiteSpace(Model.Form.SourceAccountNumber) ? "selected" : null)">Seleccione una cuenta</option>@foreach (SelectOptionViewModel option in Model.Form.SourceAccountOptions) { <option value="@option.Value">@option.Text</option> }</select><p id="Form_SourceAccountNumber-help" class="ui-field-description">Solo puede debitar una cuenta de ahorro activa propia.</p><span id="Form_SourceAccountNumber-error" class="ui-error" asp-validation-for="Form.SourceAccountNumber"></span></div>
                </div>
                <div class="ui-field"><label class="ui-label" asp-for="Form.Amount">Monto a transferir</label><input class="ui-control" asp-for="Form.Amount" type="number" min="0.01" step="0.01" inputmode="decimal" autocomplete="off" aria-invalid="@(amountInvalid ? "true" : "false")" aria-describedby="Form_Amount-help Form_Amount-error" required /><p id="Form_Amount-help" class="ui-field-description">Debe ser mayor que RD$ 0.00 y no superar el saldo disponible al confirmar.</p><span id="Form_Amount-error" class="ui-error" asp-validation-for="Form.Amount"></span></div>
                <div class="page-actions"><a class="ui-button ui-button--secondary" asp-controller="Home" asp-action="Client" aria-label="Cancelar y volver al Home">Cancelar</a><button class="ui-button ui-button--primary" type="submit" data-submitting-label="Validando transacción…"><span data-submit-label>Realizar transacción</span></button></div>
            </form>
        </div>
    </section>
}
