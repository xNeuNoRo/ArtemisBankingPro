@model MyAccountTransactionsViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["PaginationAccountNumber"] = Model.AccountNumber;
    ViewData["PaginationDateFrom"] = Model.DateFrom;
    ViewData["PaginationDateTo"] = Model.DateTo;
    ViewData["PaginationTransactionType"] = Model.TransactionType;
    string Money(decimal amount) => $"RD$ {amount.ToString("N2", CultureInfo.InvariantCulture)}";
    bool accountInvalid = ViewData.ModelState["AccountNumber"]?.Errors.Count > 0;
    bool dateFromInvalid = ViewData.ModelState["DateFrom"]?.Errors.Count > 0;
    bool dateToInvalid = ViewData.ModelState["DateTo"]?.Errors.Count > 0;
}

<section class="page-header" aria-labelledby="client-transactions-title">
    <div class="page-header__content">
        <p class="page-header__eyebrow">Cliente / Actividad</p>
        <h1 id="client-transactions-title" class="page-header__title">Transacciones</h1>
        <p class="page-header__description">Consulte los movimientos de sus cuentas activas con filtros y páginas de resultados.</p>
    </div>
    <div class="page-header__actions">
        <a class="ui-button ui-button--secondary" asp-controller="Home" asp-action="Client">Volver al Home</a>
        <a class="ui-button ui-button--primary" asp-controller="Client" asp-action="ExpressTransfer">
            <partial name="_Icon" model='@("transfer")' />
            Realizar transferencia
        </a>
    </div>
</section>

@if (Model.AccountOptions.Count == 0 && ViewData.ModelState.IsValid) {
    ViewData["EmptyTitle"] = "No tiene cuentas activas.";
    ViewData["EmptyDescription"] = "Las transacciones estarán disponibles cuando tenga una cuenta de ahorro activa.";
    <partial name="_EmptyState" />
} else {
    <section class="ui-card client-filter" aria-labelledby="transactions-filter-title">
        <div class="ui-card__header">
            <div>
                <h2 id="transactions-filter-title" class="ui-card__title">Filtrar movimientos</h2>
                <p class="ui-card__description">Los resultados se consultan desde la base de datos y respetan la propiedad de la cuenta.</p>
            </div>
        </div>
        <div class="ui-card__body">
            <form asp-controller="Client" asp-action="Transactions" method="get" class="client-filter__form" data-submit-lock>
                <div class="ui-field">
                    <label class="ui-label" for="AccountNumber">Cuenta</label>
                    <select
                        class="ui-control"
                        id="AccountNumber"
                        name="accountNumber"
                        aria-invalid="@(accountInvalid ? "true" : "false")"
                        aria-describedby="AccountNumber-help AccountNumber-error"
                        required>
                        @foreach (SelectOptionViewModel option in Model.AccountOptions) {
                            <option value="@option.Value" selected="@(option.Value == Model.AccountNumber ? "selected" : null)">@option.Text</option>
                        }
                    </select>
                    <p id="AccountNumber-help" class="ui-field-description">Solo se muestran cuentas de ahorro activas que le pertenecen.</p>
                    <span id="AccountNumber-error" class="ui-error" asp-validation-for="AccountNumber"></span>
                </div>
                <div class="ui-field">
                    <label class="ui-label" for="DateFrom">Desde</label>
                    <input
                        class="ui-control"
                        id="DateFrom"
                        name="dateFrom"
                        type="date"
                        value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))"
                        aria-invalid="@(dateFromInvalid ? "true" : "false")"
                        aria-describedby="DateFrom-help DateFrom-error" />
                    <p id="DateFrom-help" class="ui-field-description">Fecha inicial incluida en la búsqueda.</p>
                    <span id="DateFrom-error" class="ui-error" asp-validation-for="DateFrom"></span>
                </div>
                <div class="ui-field">
                    <label class="ui-label" for="DateTo">Hasta</label>
                    <input
                        class="ui-control"
                        id="DateTo"
                        name="dateTo"
                        type="date"
                        value="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                        aria-invalid="@(dateToInvalid ? "true" : "false")"
                        aria-describedby="DateTo-help DateTo-error" />
                    <p id="DateTo-help" class="ui-field-description">Fecha final incluida en la búsqueda.</p>
                    <span id="DateTo-error" class="ui-error" asp-validation-for="DateTo"></span>
                </div>
                <div class="ui-field">
                    <label class="ui-label" for="TransactionType">Tipo de movimiento</label>
                    <select class="ui-control" id="TransactionType" name="transactionType" aria-describedby="TransactionType-help">
                        @foreach (SelectOptionViewModel option in Model.TransactionTypeOptions) {
                            <option value="@option.Value" selected="@(option.Value == Model.TransactionType ? "selected" : null)">@option.Text</option>
                        }
                    </select>
                    <p id="TransactionType-help" class="ui-field-description">Filtre por crédito, débito o todos los movimientos.</p>
                </div>
                <button class="ui-button ui-button--primary" type="submit" data-submitting-label="Consultando…">Aplicar filtros</button>
            </form>
        </div>
    </section>

    @if (Model.Transactions.Count == 0) {
        ViewData["EmptyTitle"] = "No hay movimientos para estos filtros.";
        ViewData["EmptyDescription"] = "Pruebe con otra cuenta, rango de fechas o tipo de transacción.";
        <partial name="_EmptyState" />
    } else {
        <section class="client-list" aria-labelledby="transactions-list-title">
            <div class="client-list__heading">
                <div>
                    <p class="ui-section-label">Cuenta @Model.AccountNumber</p>
                    <h2 id="transactions-list-title" class="ui-card__title">Movimientos recientes</h2>
                </div>
                <span class="ui-badge ui-badge--info">@Model.Pagination.TotalItems registros</span>
            </div>
            <div class="ui-table-wrap" tabindex="0" role="region" aria-label="Tabla de transacciones">
                <table class="ui-table client-table">
                    <caption class="ui-visually-hidden">Movimientos de la cuenta @Model.AccountNumber</caption>
                    <thead>
                        <tr>
                            <th scope="col">Fecha y hora</th>
                            <th scope="col">Tipo</th>
                            <th scope="col">Monto</th>
                            <th scope="col">Beneficiario</th>
                            <th scope="col">Origen</th>
                            <th scope="col">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ClientAccountTransactionItemViewModel transaction in Model.Transactions) {
                            <tr>
                                <td>@BusinessClock.ToBusinessTime(transaction.Date).ToString("dd/MM/yyyy HH:mm")</td>
                                <td><partial name="_StatusBadge" model="transaction.TransactionType" /></td>
                                <td class="ui-table__numeric">@Money(transaction.Amount)</td>
                                <td>@transaction.Beneficiary</td>
                                <td>@transaction.Origin</td>
                                <td><partial name="_StatusBadge" model="transaction.Status" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model.Pagination" />
        </section>
    }
}
