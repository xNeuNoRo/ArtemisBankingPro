@model ClientOperationPageViewModel<ClientCardPaymentViewModel>
@{
    ViewData["Title"] = Model.PageTitle;
    bool canSubmit = Model.Form.CardOptions.Count > 0 && Model.Form.AccountOptions.Count > 0;
}

<section class="page-header" aria-labelledby="card-payment-title">
    <div class="page-header__content"><p class="page-header__eyebrow">Cliente / Crédito</p><h1 id="card-payment-title" class="page-header__title">Pago de tarjeta de crédito</h1><p class="page-header__description">Abone una tarjeta propia usando fondos de una cuenta de ahorro activa.</p></div>
</section>

@if (!canSubmit) {
    ViewData["EmptyTitle"] = Model.Form.CardOptions.Count == 0 ? "No tiene tarjetas activas." : "No tiene cuentas activas para pagar.";
    ViewData["EmptyDescription"] = "El pago estará disponible cuando tenga productos activos compatibles.";
    <partial name="_EmptyState" />
} else {
    <section class="ui-card client-form-panel" aria-labelledby="card-payment-form-title">
        <div class="ui-card__header"><div><p class="ui-section-label">Nueva operación</p><h2 id="card-payment-form-title" class="ui-card__title">Datos del pago</h2></div></div>
        <div class="ui-card__body">
            <partial name="_ValidationSummary" />
            <form asp-controller="Client" asp-action="CardPayment" method="post" data-submit-lock data-autofocus-error class="client-form">
                <input asp-for="Form.SubmissionToken" type="hidden" />
                <div class="client-form__grid">
                    <div class="ui-field"><label class="ui-label" asp-for="Form.CardId">Tarjeta de crédito</label><select class="ui-control" asp-for="Form.CardId" required><option value="0" disabled>Seleccione una tarjeta</option>@foreach (SelectOptionViewModel option in Model.Form.CardOptions) { <option value="@option.Value">@option.Text</option> }</select><span class="ui-error" asp-validation-for="Form.CardId"></span></div>
                    <div class="ui-field"><label class="ui-label" asp-for="Form.AccountNumber">Cuenta de origen</label><select class="ui-control" asp-for="Form.AccountNumber" required><option value="" disabled>Seleccione una cuenta</option>@foreach (SelectOptionViewModel option in Model.Form.AccountOptions) { <option value="@option.Value">@option.Text</option> }</select><span class="ui-error" asp-validation-for="Form.AccountNumber"></span></div>
                </div>
                <div class="ui-field"><label class="ui-label" asp-for="Form.Amount">Monto a pagar</label><input class="ui-control" asp-for="Form.Amount" type="number" min="0.01" step="0.01" inputmode="decimal" autocomplete="off" required /><p class="ui-field-description">El sistema aplicará como máximo la deuda real de la tarjeta.</p><span class="ui-error" asp-validation-for="Form.Amount"></span></div>
                <div class="page-actions"><a class="ui-button ui-button--secondary" asp-controller="Home" asp-action="Client">Cancelar</a><button class="ui-button ui-button--primary" type="submit"><span data-submit-label>Continuar</span></button></div>
            </form>
        </div>
    </section>
}
