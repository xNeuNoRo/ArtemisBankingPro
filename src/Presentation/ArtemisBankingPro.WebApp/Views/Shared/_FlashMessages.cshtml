@{
    var messages = new[] {
        (Key: "Success", Variant: "success"),
        (Key: "Error", Variant: "error"),
        (Key: "Warning", Variant: "warning"),
        (Key: "Info", Variant: "info"),
    };
}
@foreach (var message in messages) {
    string? text = TempData[message.Key] as string;
    if (!string.IsNullOrWhiteSpace(text)) {
        <div
            class="ui-alert ui-alert--@message.Variant"
            data-feedback-message="@text"
            data-feedback-variant="@message.Variant"
            role="@(message.Variant == "error" ? "alert" : "status")">
            <p class="ui-alert__content">@text</p>
        </div>
    }
}
