@{
    string title = ViewData["EmptyTitle"] as string ?? "No hay información para mostrar";
    string description = ViewData["EmptyDescription"] as string
        ?? "Cuando existan registros disponibles, aparecerán en esta sección.";
}
<section class="ui-empty-state" aria-live="polite">
    <span class="ui-empty-state__icon" aria-hidden="true">
        <partial name="_Icon" model='@("empty")' />
    </span>
    <div>
        <h2 class="ui-empty-state__title">@title</h2>
        <p class="ui-empty-state__description">@description</p>
    </div>
</section>
