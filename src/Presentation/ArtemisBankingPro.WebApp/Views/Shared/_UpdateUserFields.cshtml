@model UpdateUserViewModel
@{
    string role = ViewData["UserRole"] as string ?? string.Empty;
    bool isClient = string.Equals(role, "Cliente", StringComparison.Ordinal);
}

<div class="ui-field">
    <label class="ui-label" asp-for="FirstName">Nombre</label>
    <input class="ui-control" asp-for="FirstName" autocomplete="given-name" />
    <span class="ui-error" asp-validation-for="FirstName"></span>
</div>
<div class="ui-field">
    <label class="ui-label" asp-for="LastName">Apellido</label>
    <input class="ui-control" asp-for="LastName" autocomplete="family-name" />
    <span class="ui-error" asp-validation-for="LastName"></span>
</div>
<div class="ui-field">
    <label class="ui-label" asp-for="Identification">Cédula</label>
    <input class="ui-control" asp-for="Identification" autocomplete="off" inputmode="numeric" />
    <span class="ui-error" asp-validation-for="Identification"></span>
</div>
<div class="ui-field">
    <label class="ui-label" asp-for="Email">Correo electrónico</label>
    <input class="ui-control" asp-for="Email" autocomplete="email" inputmode="email" />
    <span class="ui-error" asp-validation-for="Email"></span>
</div>
<div class="ui-field">
    <label class="ui-label" asp-for="UserName">Nombre de usuario</label>
    <input class="ui-control" asp-for="UserName" autocomplete="username" />
    <span class="ui-error" asp-validation-for="UserName"></span>
</div>
<div class="ui-field">
    <label class="ui-label" asp-for="Password">
        Nueva contraseña
        <span class="ui-label__optional">Opcional</span>
    </label>
    <div class="ui-control-group">
        <input class="ui-control" asp-for="Password" autocomplete="new-password" />
        <button class="ui-control-group__action" type="button" data-password-toggle="Password" aria-label="Ver" aria-pressed="false"><span aria-hidden="true" data-password-label>Ver</span></button>
    </div>
    <span class="ui-error" asp-validation-for="Password"></span>
</div>
<div class="ui-field">
    <label class="ui-label" asp-for="ConfirmPassword">Confirmar nueva contraseña</label>
    <div class="ui-control-group">
        <input class="ui-control" asp-for="ConfirmPassword" autocomplete="new-password" />
        <button class="ui-control-group__action" type="button" data-password-toggle="ConfirmPassword" aria-label="Ver" aria-pressed="false"><span aria-hidden="true" data-password-label>Ver</span></button>
    </div>
    <span class="ui-error" asp-validation-for="ConfirmPassword"></span>
</div>
@if (isClient) {
    <div class="ui-field admin-form__role-dependent" data-role-dependent="Cliente">
        <label class="ui-label" asp-for="AdditionalAmount">
            Monto adicional
            <span class="ui-label__optional">Opcional</span>
        </label>
        <input class="ui-control" asp-for="AdditionalAmount" type="number" min="0" step="0.01" inputmode="decimal" autocomplete="off" />
        <span class="ui-error" asp-validation-for="AdditionalAmount"></span>
        <p class="ui-field-description">Si es mayor que cero, se acredita en la cuenta principal y queda registrado.</p>
    </div>
}
