@model LoanAssignmentPageViewModel
@{
    ViewData["Title"] = "Asignar préstamo";
    string Money(decimal amount) => $"RD$ {amount.ToString("N2", CultureInfo.InvariantCulture)}";
}

<section class="page-header" aria-labelledby="loan-create-title">
    <div class="page-header__content">
        <p class="page-header__eyebrow">Administración / Préstamos</p>
        <h1 id="loan-create-title" class="page-header__title">Configurar préstamo</h1>
        <p class="page-header__description">Los cálculos, el riesgo y el desembolso se validan nuevamente en Application.</p>
    </div>
</section>

<form method="post" asp-action="Create" asp-route-customerId="@Model.Customer.ClientId" class="admin-product__form" data-submit-lock data-autofocus-error>
    <input type="hidden" name="submissionToken" value="@Model.SubmissionToken" />
    <partial name="_ValidationSummary" />

    <section class="ui-card" aria-labelledby="loan-customer-title">
        <div class="ui-card__header">
            <div>
                <p class="ui-section-label">Cliente seleccionado</p>
                <h2 id="loan-customer-title" class="ui-card__title">@Model.Customer.FullName</h2>
                <p class="ui-card__description">Cédula: @Model.Customer.Identification · @Model.Customer.Email</p>
            </div>
            <span class="ui-badge ui-badge--active">Activo</span>
        </div>
        <div class="ui-card__body admin-product__metric-grid">
            <div class="admin-product__metric">
                <span class="admin-product__metric-label">Deuda actual</span>
                <strong class="admin-product__metric-value">@Money(Model.Customer.TotalDebt)</strong>
            </div>
            <div class="admin-product__metric">
                <span class="admin-product__metric-label">Identificador</span>
                <strong class="admin-product__metric-value">@Model.Customer.ClientId</strong>
            </div>
        </div>
    </section>

    <section class="ui-card" aria-labelledby="loan-form-title">
        <div class="ui-card__header">
            <div>
                <p class="ui-section-label">Condiciones</p>
                <h2 id="loan-form-title" class="ui-card__title">Datos del préstamo</h2>
            </div>
        </div>
        <div class="ui-card__body admin-product__form-grid">
            <div class="ui-field">
                <label class="ui-label" asp-for="Form.TermMonths">Plazo del préstamo</label>
                <select class="ui-control" asp-for="Form.TermMonths" autocomplete="off" required>
                    <option value="" disabled>Seleccione un plazo</option>
                    @foreach (int term in new[] { 6, 12, 18, 24, 30, 36, 42, 48, 54, 60 }) {
                        <option value="@term">@term meses</option>
                    }
                </select>
                <span class="ui-error" asp-validation-for="Form.TermMonths"></span>
            </div>
            <div class="ui-field">
                <label class="ui-label" asp-for="Form.CapitalAmount">Monto a prestar</label>
                <input class="ui-control" asp-for="Form.CapitalAmount" type="number" min="0.01" step="0.01" inputmode="decimal" autocomplete="off" required />
                <span class="ui-error" asp-validation-for="Form.CapitalAmount"></span>
            </div>
            <div class="ui-field">
                <label class="ui-label" asp-for="Form.AnnualInterestRate">Tasa de interés anual</label>
                <input class="ui-control" asp-for="Form.AnnualInterestRate" type="number" min="0" step="0.01" inputmode="decimal" autocomplete="off" required />
                <span class="ui-error" asp-validation-for="Form.AnnualInterestRate"></span>
            </div>
        </div>
    </section>

    <div class="page-actions">
        <button class="ui-button ui-button--primary" type="submit" data-submitting-label="Validando…">
            <span data-submit-label>Asignar préstamo</span>
        </button>
        <a class="ui-button ui-button--secondary" asp-action="Assign">Volver atrás</a>
    </div>
</form>
