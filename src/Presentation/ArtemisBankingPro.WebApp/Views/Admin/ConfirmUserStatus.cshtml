@model UserStatusConfirmationViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="page-header" aria-labelledby="status-confirmation-title">
    <div class="page-header__content">
        <p class="page-header__eyebrow">Administración / Usuarios</p>
        <h1 id="status-confirmation-title" class="page-header__title">@Model.Title</h1>
        <p class="page-header__description">Confirme la transición antes de aplicarla.</p>
    </div>
</section>

<section class="ui-card admin-confirmation" aria-labelledby="status-confirmation-card-title">
    <div class="ui-card__body">
        <partial name="_ValidationSummary" />
        <div class="ui-confirmation-panel">
            <div>
                <p class="ui-section-label">Acción protegida</p>
                <h2 id="status-confirmation-card-title" class="ui-confirmation-panel__title">@Model.Message</h2>
                <p class="ui-card__description">
                    Usuario: <strong>@Model.UserName</strong> · @Model.FullName · Rol: @Model.Role
                </p>
            </div>
            <div class="admin-confirmation__transition" aria-label="Cambio de estado">
                <partial name="_StatusBadge" model='@(Model.CurrentIsActive ? "Activo" : "Inactivo")' />
                <span aria-hidden="true">→</span>
                <partial name="_StatusBadge" model='@(Model.TargetIsActive ? "Activo" : "Inactivo")' />
            </div>
        </div>

        <form
            method="post"
            asp-action="ConfirmUserStatus"
            asp-route-id="@Model.UserId"
            asp-route-targetActive="@Model.TargetIsActive"
            class="page-actions"
            data-submit-lock>
            <input asp-for="ConfirmationToken" type="hidden" />
            <button class="ui-button ui-button--primary" type="submit" data-submitting-label="Aplicando…">
                <span data-submit-label>@Model.ConfirmButtonText</span>
            </button>
            <a class="ui-button ui-button--secondary" asp-action="Users">@Model.CancelButtonText</a>
        </form>
    </div>
</section>
