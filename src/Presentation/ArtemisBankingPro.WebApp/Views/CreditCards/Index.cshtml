@model CreditCardListViewModel
@{
    ViewData["Title"] = "Gestión de tarjetas de crédito";
    ViewData["PaginationStatus"] = Model.Status;
    ViewData["PaginationIdentification"] = Model.Identification;
    string Money(decimal amount) => $"RD$ {amount.ToString("N2", CultureInfo.InvariantCulture)}";
    bool identificationInvalid = ViewData.ModelState[nameof(Model.Identification)]?.Errors.Count > 0;
    bool statusInvalid = ViewData.ModelState[nameof(Model.Status)]?.Errors.Count > 0;
    string CardClass(int index) => $"visual-card--{((index % 5) switch { 0 => "visa", 1 => "mastercard", 2 => "artemis", 3 => "premium", _ => "gold" })}";
    string Brand(int index) => (index % 5) switch { 0 => "Visa", 1 => "Mastercard", 2 => "Artemis", 3 => "Premium", _ => "Gold" };
}

<section class="page-header" aria-labelledby="cards-title">
    <div class="page-header__content">
        <p class="page-header__eyebrow">Administración / Productos</p>
        <h1 id="cards-title" class="page-header__title">Gestión de tarjetas de crédito</h1>
        <p class="page-header__description">Consulte tarjetas, consumos, límites y cancelaciones protegidas.</p>
    </div>
    <div class="page-header__actions">
        <a class="ui-button ui-button--primary" asp-action="Assign">
            <partial name="_Icon" model='@("card")' />
            Asignar tarjeta de crédito
        </a>
    </div>
</section>

@if (Model.HasLoadError) {
    <section class="ui-alert ui-alert--error" role="alert" aria-live="assertive" aria-labelledby="cards-load-error-title">
        <h2 id="cards-load-error-title" class="ui-visually-hidden">No fue posible cargar las tarjetas</h2>
        <p class="ui-alert__content">@Model.LoadErrorMessage</p>
        <a class="ui-button ui-button--secondary ui-button--small" asp-action="Index" asp-route-status="@Model.Status" asp-route-identification="@Model.Identification" asp-route-page="1" asp-route-pageSize="20" aria-label="Reintentar la carga de tarjetas">
            Reintentar tarjetas
        </a>
    </section>
} else {
    <partial name="_ValidationSummary" />
    <section class="ui-card admin-product__filter" aria-labelledby="cards-filter-title">
        <div class="ui-card__body">
            <h2 id="cards-filter-title" class="ui-card__title">Buscar y filtrar tarjetas</h2>
            <form method="get" asp-action="Index" class="admin-filter" data-submit-lock>
                <div class="ui-field">
                    <label class="ui-label" asp-for="Identification">Buscar por cédula</label>
                    <input class="ui-control" asp-for="Identification" autocomplete="off" inputmode="numeric" aria-invalid="@(identificationInvalid ? "true" : "false")" aria-describedby="Identification-help Identification-error" />
                    <p id="Identification-help" class="ui-field-description">Ingrese la cédula como texto y conserve los ceros iniciales.</p>
                    <span class="ui-error" asp-validation-for="Identification"></span>
                </div>
                <div class="ui-field">
                    <label class="ui-label" asp-for="Status">Estado</label>
                    <select class="ui-control" asp-for="Status" autocomplete="off" aria-invalid="@(statusInvalid ? "true" : "false")" aria-describedby="Status-help Status-error">
                        @foreach (SelectOptionViewModel option in Model.StatusOptions) {
                            <option value="@option.Value" selected="@(option.IsSelected ? "selected" : null)">@option.Text</option>
                        }
                    </select>
                    <p id="Status-help" class="ui-field-description">Por defecto muestra tarjetas activas. Puede revisar canceladas o todas.</p>
                    <span class="ui-error" asp-validation-for="Status"></span>
                </div>
                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="pageSize" value="20" />
                <button class="ui-button ui-button--secondary" type="submit" data-submitting-label="Filtrando…"><span data-submit-label>Aplicar filtros</span></button>
            </form>
        </div>
    </section>

    @if (ViewData.ModelState.IsValid && Model.Cards.Count == 0) {
        ViewData["EmptyTitle"] = string.IsNullOrWhiteSpace(Model.Identification)
            ? "No hay tarjetas para mostrar"
            : "Este cliente no tiene tarjetas de crédito registradas.";
        ViewData["EmptyDescription"] = "Pruebe con otra cédula o cambie el filtro de estado.";
        <partial name="_EmptyState" />
    } else if (ViewData.ModelState.IsValid && Model.Cards.Count > 0) {
        <section class="admin-product__list" aria-labelledby="cards-list-title">
            <div class="admin-users__list-heading">
                <div>
                    <p class="ui-section-label">Cartera administrada</p>
                    <h2 id="cards-list-title" class="ui-card__title">Tarjetas registradas</h2>
                </div>
                <span class="ui-badge ui-badge--neutral">@Model.Pagination.TotalItems registros</span>
            </div>
            <div class="visual-card-grid" role="list" aria-label="Tarjetas de crédito registradas">
                @for (int i = 0; i < Model.Cards.Count; i++) {
                    CreditCardSummaryViewModel card = Model.Cards[i];
                    string fakeBin = ((i % 2 == 0 ? 400000 : 520000) + card.Id % 10000).ToString(CultureInfo.InvariantCulture);
                    <article class="credit-card-item" role="listitem">
                        <div class="visual-card @CardClass(i)">
                            <div class="visual-card__top"><span class="visual-card__chip" aria-hidden="true"></span><span class="visual-card__network-name">@Brand(i)</span></div>
                            <div class="visual-card__number">@card.MaskedNumber</div>
                            <div class="visual-card__footer">
                                <div><span class="visual-card__label">Titular</span><strong class="visual-card__value">@card.ClientFullName</strong></div>
                                <div><span class="visual-card__label">Expira</span><strong class="visual-card__value">@card.Expiration</strong></div>
                            </div>
                            <div class="visual-card__bottom"><span class="visual-card__type-badge">Crédito</span><span class="visual-card__bin">BIN @fakeBin</span><span class="visual-card__contactless" aria-hidden="true"></span></div>
                        </div>
                        <div class="credit-card-item__body">
                            <div class="credit-card-metrics">
                                <div><span>Límite</span><strong>@Money(card.CreditLimit)</strong></div>
                                <div><span>Deuda</span><strong>@Money(card.CurrentDebt)</strong></div>
                                <div><span>Disponible</span><strong>@Money(card.AvailableCredit)</strong></div>
                            </div>
                            <div class="credit-card-item__status"><span>Estado de la tarjeta</span><partial name="_StatusBadge" model="card.Status" /></div>
                            <div class="credit-card-item__actions" aria-label="Acciones para la tarjeta @card.MaskedNumber">
                                <a class="ui-button ui-button--secondary ui-button--small" asp-action="Details" asp-route-id="@card.Id">Ver detalles</a>
                                @if (card.Status.Equals("Active", StringComparison.OrdinalIgnoreCase) || card.Status.Equals("Activa", StringComparison.OrdinalIgnoreCase)) {
                                    <a class="ui-button ui-button--secondary ui-button--small" asp-action="EditLimit" asp-route-id="@card.Id">Editar límite</a>
                                    <a class="ui-button ui-button--danger ui-button--small" asp-action="ConfirmCancel" asp-route-id="@card.Id">Cancelar</a>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
            <partial name="_Pagination" model="Model.Pagination" />
        </section>
    }
}
