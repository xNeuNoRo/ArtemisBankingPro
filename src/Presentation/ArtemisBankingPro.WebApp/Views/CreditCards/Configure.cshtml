@model CreditCardAssignmentPageViewModel
@{
    ViewData["Title"] = "Asignar tarjeta de crédito";
    string Money(decimal amount) => $"RD$ {amount.ToString("N2", CultureInfo.InvariantCulture)}";
}

<section class="page-header" aria-labelledby="card-configure-title">
    <div class="page-header__content">
        <p class="page-header__eyebrow">Administración / Tarjetas</p>
        <h1 id="card-configure-title" class="page-header__title">Asignar tarjeta de crédito</h1>
        <p class="page-header__description">El número, CVC y fecha de vencimiento se generan y validan server-side.</p>
    </div>
</section>

<form method="post" asp-action="Configure" asp-route-customerId="@Model.Customer.ClientId" class="admin-product__form" data-submit-lock data-autofocus-error>
    <input type="hidden" name="submissionToken" value="@Model.SubmissionToken" />
    <partial name="_ValidationSummary" />
    <section class="ui-card" aria-labelledby="card-customer-title">
        <div class="ui-card__header"><div><p class="ui-section-label">Cliente seleccionado</p><h2 id="card-customer-title" class="ui-card__title">@Model.Customer.FullName</h2><p class="ui-card__description">Cédula: @Model.Customer.Identification · @Model.Customer.Email</p></div><span class="ui-badge ui-badge--active">Activo</span></div>
        <div class="ui-card__body admin-product__metric-grid"><div class="admin-product__metric"><span class="admin-product__metric-label">Deuda actual</span><strong class="admin-product__metric-value">@Money(Model.Customer.TotalDebt)</strong></div><div class="admin-product__metric"><span class="admin-product__metric-label">Identificador</span><strong class="admin-product__metric-value">@Model.Customer.ClientId</strong></div></div>
    </section>
    <section class="ui-card" aria-labelledby="card-limit-title">
        <div class="ui-card__header"><div><p class="ui-section-label">Condiciones</p><h2 id="card-limit-title" class="ui-card__title">Límite inicial</h2></div></div>
        <div class="ui-card__body admin-product__form-grid">
            <div class="ui-field"><label class="ui-label" asp-for="Form.CreditLimit">Límite de crédito</label><input class="ui-control" asp-for="Form.CreditLimit" type="number" min="0.01" step="0.01" inputmode="decimal" autocomplete="off" required /><span class="ui-error" asp-validation-for="Form.CreditLimit"></span></div>
        </div>
    </section>
    <div class="page-actions"><button class="ui-button ui-button--primary" type="submit" data-submitting-label="Validando…"><span data-submit-label>Asignar tarjeta</span></button><a class="ui-button ui-button--secondary" asp-action="Assign">Volver atrás</a></div>
</form>
