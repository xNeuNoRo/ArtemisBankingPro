@model CancelCreditCardViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="page-header" aria-labelledby="card-cancel-title">
    <div class="page-header__content">
        <p class="page-header__eyebrow">Administración / Tarjetas</p>
        <h1 id="card-cancel-title" class="page-header__title">@Model.Title</h1>
        <p class="page-header__description">La tarjeta debe estar activa y no tener deuda pendiente para completar la cancelación.</p>
    </div>
</section>
<section class="ui-card admin-confirmation" aria-labelledby="card-cancel-card-title">
    <div class="ui-card__body">
        <partial name="_ValidationSummary" />
        <div class="ui-confirmation-panel">
            <div>
                <p class="ui-section-label">Acción protegida</p>
                <h2 id="card-cancel-card-title" class="ui-confirmation-panel__title">@Model.Message</h2>
                <p id="card-cancel-help" class="ui-card__description">Solo se muestra la terminación de la tarjeta: <strong>@Model.LastFour</strong>. El servidor volverá a verificar la deuda antes de cancelar.</p>
            </div>
            <partial name="_StatusBadge" model='@("Activa")' />
        </div>
        <form method="post" asp-action="ConfirmCancel" asp-route-id="@Model.CardId" class="page-actions" data-submit-lock data-autofocus-error aria-describedby="card-cancel-help">
            <input asp-for="ConfirmationToken" type="hidden" />
            <button class="ui-button ui-button--danger" type="submit" data-submitting-label="Cancelando…"><span data-submit-label>@Model.ConfirmButtonText</span></button>
            <a class="ui-button ui-button--secondary" asp-action="Index">@Model.CancelButtonText</a>
        </form>
    </div>
</section>
