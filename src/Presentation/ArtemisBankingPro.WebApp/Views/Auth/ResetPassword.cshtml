@model ResetPasswordViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Crear nueva contraseña";
    bool hasResetFlow = !string.IsNullOrWhiteSpace(Model.Token);
    bool passwordInvalid = ViewData.ModelState[nameof(ResetPasswordViewModel.Password)]?.Errors.Count > 0;
    bool confirmPasswordInvalid = ViewData.ModelState[nameof(ResetPasswordViewModel.ConfirmPassword)]?.Errors.Count > 0;
}

<div class="auth-content">
    <p class="page-header__eyebrow">Recuperación de acceso</p>
    <h1 class="auth-content__title">Crear nueva contraseña</h1>
    <p class="auth-content__description">
        Defina una contraseña nueva para volver a activar su cuenta.
    </p>

    <partial name="_ValidationSummary" />

    @if (hasResetFlow) {
        <form asp-controller="Auth" asp-action="ResetPassword" method="post" class="auth-form" data-submit-lock data-autofocus-error>
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div class="ui-field">
                <label asp-for="Password" class="ui-label">Nueva contraseña</label>
                <div class="ui-control-group">
                    <input asp-for="Password"
                           class="ui-control"
                           autocomplete="new-password"
                           aria-invalid="@(passwordInvalid ? "true" : "false")"
                           aria-describedby="Password-help Password-error" />
                    <button type="button"
                            class="ui-control-group__action"
                            data-password-toggle="Password"
                             aria-label="Ver"
                            aria-pressed="false">
                             <span aria-hidden="true" data-password-label>Ver</span>
                    </button>
                </div>
                <span asp-validation-for="Password" id="Password-error" class="ui-error"></span>
                <div class="ui-password-strength" data-password-strength="Password">
                    <div class="ui-password-strength__meter"
                         role="progressbar"
                         aria-label="Fortaleza de la contraseña"
                         aria-valuemin="0"
                         aria-valuemax="100"
                         aria-valuenow="0">
                        <span data-strength-bar></span>
                    </div>
                    <span class="ui-password-strength__label" data-strength-label>Sin evaluar</span>
                    <p id="Password-help" class="ui-help">Use al menos 8 caracteres, mayúsculas, minúsculas, números y símbolos.</p>
                </div>
            </div>

            <div class="ui-field">
                <label asp-for="ConfirmPassword" class="ui-label">Confirmar contraseña</label>
                <input asp-for="ConfirmPassword"
                       class="ui-control"
                       autocomplete="new-password"
                       aria-invalid="@(confirmPasswordInvalid ? "true" : "false")"
                       aria-describedby="ConfirmPassword-error" />
                <span asp-validation-for="ConfirmPassword" id="ConfirmPassword-error" class="ui-error"></span>
            </div>

            <button type="submit" class="ui-button ui-button--primary auth-form__submit">
                <span data-submit-label>Restablecer contraseña</span>
            </button>
        </form>
    } else {
        <div class="ui-empty-state ui-empty-state--compact">
            <strong class="ui-empty-state__title">El enlace no está disponible</strong>
            <p class="ui-empty-state__description">
                Solicite un nuevo restablecimiento de contraseña.
            </p>
        </div>
    }

    <div class="auth-content__links">
        <a asp-controller="Auth" asp-action="Login">Volver a iniciar sesión</a>
    </div>
</div>
