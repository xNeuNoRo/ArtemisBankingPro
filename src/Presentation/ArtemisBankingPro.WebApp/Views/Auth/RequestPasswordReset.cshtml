@model RequestPasswordResetViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Restablecer contraseña";
    bool userNameInvalid = ViewData.ModelState[nameof(RequestPasswordResetViewModel.UserName)]?.Errors.Count > 0;
}

<div class="auth-content">
    <p class="page-header__eyebrow">Recuperación de acceso</p>
    <h1 class="auth-content__title">Restablecer contraseña</h1>
    <p class="auth-content__description">
        Indique su nombre de usuario y recibirá un enlace seguro en el correo registrado.
    </p>

    <form asp-controller="Auth" asp-action="RequestPasswordReset" method="post" class="auth-form" data-submit-lock data-autofocus-error>
        <partial name="_ValidationSummary" />

        <div class="ui-field">
            <label asp-for="UserName" class="ui-label">Nombre de usuario</label>
            <input asp-for="UserName"
                   class="ui-control"
                   autocomplete="username"
                   aria-invalid="@(userNameInvalid ? "true" : "false")"
                   aria-describedby="UserName-help UserName-error" />
            <p id="UserName-help" class="ui-help">
                Solo pueden usar este proceso los roles habilitados para la aplicación web.
            </p>
            <span asp-validation-for="UserName" id="UserName-error" class="ui-error"></span>
        </div>

        <button type="submit" class="ui-button ui-button--primary auth-form__submit">
            <span data-submit-label>Enviar solicitud</span>
        </button>
    </form>

    <div class="auth-content__links">
        <a asp-controller="Auth" asp-action="Login">Volver a iniciar sesión</a>
    </div>
</div>
